[gd_resource type="ShaderMaterial" format=3 uid="uid://dxw1ln475muce"]

[ext_resource type="CompressedTexture2DArray" uid="uid://2tvwomlni7aj" path="res://assets/textures/bill/bill_array.jpg" id="1_ykqcd"]
[ext_resource type="Texture2D" uid="uid://co0ubes2jkrbt" path="res://assets/textures/bill/number_atlas_packed.png" id="2_sd3dj"]

[sub_resource type="Shader" id="Shader_gnqur"]
code = "shader_type spatial;

uniform sampler2DArray base_textures : source_color, filter_linear_mipmap;
uniform sampler2D font_atlas : source_color, filter_linear_mipmap;

uniform vec2 text_position = vec2(0.1, 0.1);
uniform float char_width = 0.05;
uniform float letter_gap = 0.1;

uniform float texture_aspect = 2.0;
uniform vec2 atlas_size = vec2(708.0, 128.0);

instance uniform int bill_amount = 100;
instance uniform int texture_index : hint_range(0, 6) = 0;
instance uniform vec4 text_color : source_color = vec4(0.0, 0.0, 0.0, 1.0);

void fragment() {
	vec4 albedo = texture(base_textures, vec3(UV, float(texture_index)));
	
	int num_digits = bill_amount >= 1000 ? 4 : (bill_amount >= 100 ? 3 : (bill_amount >= 10 ? 2 : 1));
	
	float char_pixel_width = atlas_size.x / 10.0;
	float atlas_char_aspect = char_pixel_width / atlas_size.y;
	float char_height = char_width * texture_aspect / atlas_char_aspect;
	
	float step_width = char_width * (1.0 + letter_gap);
	float total_width = char_width * float(num_digits) + (char_width * letter_gap) * float(num_digits - 1);
	
	if (UV.x >= text_position.x && UV.x <= text_position.x + total_width &&
		UV.y >= text_position.y && UV.y <= text_position.y + char_height) {
		
		float local_x = UV.x - text_position.x;
		int digit_idx = int(local_x / step_width);
		float char_local_x = local_x - float(digit_idx) * step_width;
		
		if (char_local_x <= char_width) {
			int divisor = 1;
			for (int i = 0; i < (num_digits - 1 - digit_idx); i++) {
				divisor *= 10;
			}
			int digit = (bill_amount / divisor) % 10;
			
			vec2 atlas_uv = vec2(
				(char_local_x / char_width + float(digit)) * 0.1,
				(UV.y - text_position.y) / char_height
			);
			
			float mask = texture(font_atlas, atlas_uv).a;
			albedo.rgb = mix(albedo.rgb, text_color.rgb, mask * text_color.a);
		}
	}
	
	ALBEDO = albedo.rgb;
}"

[resource]
render_priority = 0
shader = SubResource("Shader_gnqur")
shader_parameter/base_textures = ExtResource("1_ykqcd")
shader_parameter/font_atlas = ExtResource("2_sd3dj")
shader_parameter/text_position = Vector2(0.202, 0.022)
shader_parameter/char_width = 0.112
shader_parameter/letter_gap = 0.1
shader_parameter/texture_aspect = 2.0
shader_parameter/atlas_size = Vector2(708, 128)
