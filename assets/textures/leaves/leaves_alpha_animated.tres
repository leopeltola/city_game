[gd_resource type="ShaderMaterial" format=3 uid="uid://m7s2tja6ov58"]

[ext_resource type="Texture2D" uid="uid://c67c1ch5a2ltd" path="res://assets/textures/leaves/leaf_alpha.png" id="1_0ilqq"]

[sub_resource type="Shader" id="Shader_rflt1"]
code = "shader_type spatial;
render_mode cull_disabled, depth_draw_opaque;

uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform float alpha_scissor_threshold : hint_range(0.0, 1.0, 0.001) = 0.5;
uniform vec4 backlight : source_color = vec4(0.3, 0.3, 0.3, 1.0);

uniform float sway_speed : hint_range(0.0, 10.0) = 1.5;
uniform float sway_strength : hint_range(0.0, 1.0) = 0.05;
uniform float sway_phase_offset : hint_range(0.0, 10.0) = 1.0;

void vertex() {
	float height_factor = max(0.0, VERTEX.y);
	vec3 world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float wave = sin(TIME * sway_speed + (world_pos.x + world_pos.z) * sway_phase_offset);

	VERTEX.x += wave * sway_strength * height_factor;
	VERTEX.z += wave * sway_strength * 0.5 * height_factor;
}

void fragment() {
	vec4 albedo_tex = texture(texture_albedo, UV);
	ALBEDO = albedo_tex.rgb;
	ALPHA = albedo_tex.a;
	ALPHA_SCISSOR_THRESHOLD = alpha_scissor_threshold;
	BACKLIGHT = backlight.rgb;
}"

[resource]
render_priority = 0
shader = SubResource("Shader_rflt1")
shader_parameter/texture_albedo = ExtResource("1_0ilqq")
shader_parameter/alpha_scissor_threshold = 0.5
shader_parameter/backlight = Color(0.4509804, 0.57254905, 0.21568628, 1)
shader_parameter/sway_speed = 1.5
shader_parameter/sway_strength = 0.05
shader_parameter/sway_phase_offset = 1.0
