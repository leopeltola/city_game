[gd_resource type="ShaderMaterial" format=3 uid="uid://cc7nbmx4rwr28"]

[ext_resource type="Texture2D" uid="uid://bjsvmr2c37f0i" path="res://assets/textures/gradient/gradients1.webp" id="1_kf8kp"]

[sub_resource type="Shader" id="Shader_5nvts"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, diffuse_toon, specular_toon;

uniform sampler2D albedo_texture : source_color, filter_linear_mipmap;
uniform vec4 gem_tint : source_color = vec4(0.85, 0.95, 1.0, 1.0);

// Dispersion and internal sparkle controls
uniform float dispersion_strength : hint_range(0.0, 2.0) = 0.75;
uniform float dispersion_frequency : hint_range(1.0, 30.0) = 8.0;
uniform float spark_threshold : hint_range(0.0, 1.0) = 0.6;

// Edge and surface controls
uniform float rim_intensity : hint_range(0.0, 2.0) = 0.5;
uniform float rim_power : hint_range(0.5, 10.0) = 3.5;
uniform float roughness : hint_range(0.0, 1.0) = 0.05;
uniform float metallic : hint_range(0.0, 1.0) = 0.1;

vec3 get_spectral_color(float t) {
	return 0.5 + 0.5 * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67)));
}

void fragment() {
	vec4 base_tex = texture(albedo_texture, UV);

	// Calculate view-space reflection vector for internal dispersion
	vec3 view_dir = normalize(VIEW);
	vec3 ref_vec = reflect(-view_dir, NORMAL);

	// Project reflection across surface normal to create angular color shifting
	float facet_phase = dot(ref_vec, NORMAL) * dispersion_frequency + ref_vec.y * 2.0;
	vec3 spectral_dispersion = get_spectral_color(facet_phase);

	// Threshold dispersion to make sparkles concentrate on glancing angles
	float sparkle_mask = smoothstep(spark_threshold, 1.0, fract(facet_phase));
	vec3 dispersion_glow = spectral_dispersion * sparkle_mask * dispersion_strength;

	// Silhouette edge glow
	float fresnel = pow(1.0 - clamp(dot(NORMAL, view_dir), 0.0, 1.0), rim_power);
	vec3 rim_glow = fresnel * rim_intensity * gem_tint.rgb;

	ALBEDO = base_tex.rgb * gem_tint.rgb;
	EMISSION = dispersion_glow + rim_glow;
	ROUGHNESS = roughness;
	METALLIC = metallic;
}"

[resource]
render_priority = 0
shader = SubResource("Shader_5nvts")
shader_parameter/albedo_texture = ExtResource("1_kf8kp")
shader_parameter/gem_tint = Color(0.85, 0.95, 1, 1)
shader_parameter/dispersion_strength = 0.6950000330125
shader_parameter/dispersion_frequency = 8.0
shader_parameter/spark_threshold = 0.7350000349125
shader_parameter/rim_intensity = 0.6
shader_parameter/rim_power = 3.0
shader_parameter/roughness = 0.05
shader_parameter/metallic = 0.1
